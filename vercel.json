{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/info",
      "destination": "/api/x/info"
    },
    {
      "source": "/api/events",
      "destination": "/api/x/events"
    },
    {
      "source": "/api/audit",
      "destination": "/api/x/audit"
    },
    {
      "source": "/v2",
      "destination": "/v2/inicio.html"
    },
    {
      "source": "/v2/",
      "destination": "/v2/inicio.html"
    },
    {
      "source": "/((?!api/|v2/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/music/[action].js": {
      "maxDuration": 30
    }
  }
}
