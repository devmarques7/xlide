# XLIDE · develop com Supabase. Copie para .env.local (não vai para o git) e preencha.
# Sem estas variáveis o app funciona como antes (código 1423, dados no Redis / arquivos locais).

# Navegador (públicas): login com o Google
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key (sb_publishable_…) ou a antiga "anon"
VITE_SUPABASE_ANON_KEY=

# Servidor (secretas): dados no Supabase, eventos, auditoria, MCP
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Secret key (sb_secret_…) ou a antiga "service_role". Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Só para copiar os dados atuais do XLIDE (scripts/migrate-redis-to-supabase.mjs). Leitura apenas.
REDIS_URL=
# ou: KV_REST_API_URL= e KV_REST_API_TOKEN=

# Chave do MCP (sem ela, vale o código 1423)
XLIDE_MCP_KEY=
